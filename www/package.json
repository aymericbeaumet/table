{
	"name": "www",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"update": "ncu --upgrade; npm install; npm install -D @sveltejs/kit@next @sveltejs/adapter-static@next",
		"dev": "svelte-kit dev --host localhost",
		"build": "svelte-kit build && svelte-sitemap --domain https://jointable.io",
		"lint": "prettier --check --plugin-search-dir=. . && eslint --ignore-path .gitignore . && svelte-check --tsconfig ./tsconfig.json",
		"test": "jest",
		"deploy": "netlify deploy --prod -d build",
		"format": "prettier --write --plugin-search-dir=. ."
	},
	"dependencies": {
		"@msgpack/msgpack": "^2.7.0",
		"get-video-id": "^3.2.0",
		"ion-sdk-js": "^1.7.2",
		"lodash": "^4.17.21",
		"svelte-favicon-badge": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^1.0.0-next.16",
		"@sveltejs/kit": "^1.0.0-next.145",
		"@tsconfig/svelte": "^2.0.1",
		"@types/jest": "^27.0.0",
		"@types/lodash": "^4.14.172",
		"@typescript-eslint/eslint-plugin": "^4.29.1",
		"@typescript-eslint/parser": "^4.29.1",
		"eslint": "^7.32.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-svelte3": "^3.2.0",
		"jest": "^27.0.6",
		"netlify-cli": "^6.2.3",
		"npm-check-updates": "^11.8.3",
		"prettier": "^2.3.2",
		"prettier-plugin-svelte": "^2.3.1",
		"svelte": "^3.42.1",
		"svelte-check": "^2.2.4",
		"svelte-preprocess": "^4.7.4",
		"svelte-sitemap": "^1.5.0",
		"ts-jest": "^27.0.4",
		"typescript": "^4.3.5"
	}
}
