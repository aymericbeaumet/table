{
	"name": "www",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"update": "npm audit fix --force; npm install -D @sveltejs/kit@next @sveltejs/adapter-static@next; npx ncu -u; npm install",
		"dev": "svelte-kit dev --host 0.0.0.0",
		"build": "svelte-kit build",
		"test": "true",
		"lint": "prettier --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
		"deploy": "netlify deploy --prod -d build",
		"format": "prettier --write --plugin-search-dir=. ."
	},
	"dependencies": {
		"@msgpack/msgpack": "^2.7.0",
		"get-video-id": "^3.2.0",
		"ion-sdk-js": "^1.7.2",
		"lodash": "^4.17.21",
		"svelte-favicon-badge": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^1.0.0-next.16",
		"@sveltejs/kit": "^1.0.0-next.144",
		"eslint": "^7.32.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-svelte3": "^3.2.0",
		"netlify-cli": "^6.0.8",
		"prettier": "~2.3.2",
		"prettier-plugin-svelte": "^2.3.1",
		"svelte": "^3.42.1"
	}
}
